# Postgres connection string.
# Local: `docker compose up -d` gives postgresql://postgres:postgres@127.0.0.1:5432/labstash
# Vercel: set automatically when you connect a Neon database.
# Integration tests use the same server with "_test" appended to the database name.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/labstash

# Signs sessions and API keys. Use a long random string: `openssl rand -hex 32`
PAYLOAD_SECRET=

# Vercel Blob read-write token. Leave empty locally and uploads are stored in ./media.
# Required on Vercel: the serverless filesystem is read-only.
BLOB_READ_WRITE_TOKEN=

# `npm run dev` only: an admin user is created on first start and signed in automatically.
# Defaults: dev@labstash.local / dev
DEV_USER_EMAIL=
DEV_USER_PASSWORD=
